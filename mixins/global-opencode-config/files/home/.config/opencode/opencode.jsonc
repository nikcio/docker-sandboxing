{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "share": "disabled",
  "permission": {
    "glob": "allow",
    "edit": "allow",
    "read": "allow",
    "bash": "allow",
    "lsp": "allow",
    "grep": "allow",
    "list": "allow",
    "question": "allow",
    "skill": "allow",
    "task": "allow",
    "todowrite": "allow",
    "webfetch": "allow",
    "external_directory": "allow",
    // websearch sends queries to a third-party service (Exa); keep it off.
    "websearch": "deny",
  }
}
