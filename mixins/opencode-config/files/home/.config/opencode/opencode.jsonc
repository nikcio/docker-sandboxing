{
  "$schema": "https://opencode.ai/config.json",
  // Permissive baseline shipped by the opencode-config mixin
  // (mixins/opencode-config).
  //
  // This file sits in the global config layer (~/.config/opencode) as
  // opencode.jsonc; the sandbox-managed opencode.json (MCP gateway wiring)
  // is a separate file and both are merged by OpenCode. Kit layers loaded
  // through OPENCODE_CONFIG (e.g. the Zeldoc provider from the zeldoc
  // mixin) merge above this file.
  //
  // The sandbox is the isolation boundary — don't nag the agent.
  "autoupdate": false, // Auto update only runs after first session so it doesn't make sense for this use case.
  "permission": {
    "glob": "allow",
    "edit": "allow",
    "read": "allow",
    "bash": "allow",
    "lsp": "allow",
    "grep": "allow",
    "list": "allow",
    "question": "allow",
    "skill": "allow",
    "task": "allow",
    "todowrite": "allow",
    "webfetch": "allow",
    "external_directory": "allow",
  }
}
